{% comment %}
  /**
    * @param {object} main_menu - The main menu object
    * @param {string} nav_position - navigation position
    * @param {boolean} show_mega_products - show mega products
    * @param {string} hover_menu - hover menu
    * @param {string} [text_direction] - text direction (falls back to settings.text_direction)
    * @param {boolean} quick_add_enable - whether quick add is enabled
    * @param {boolean} quick_shop_enable - whether quick shop is enabled
    * @param {string} product_grid_image_size - the image size to use for the grid item
    * @param {boolean} product_grid_image_fill - whether the image should fill the grid item
    * @param {boolean} product_hover_image - whether second image will be shown on hover
    * @param {boolean} enable_swatches - whether swatches are enabled
    * @param {boolean} vendor_enable - whether to show the vendor
    * @param {boolean} product_save_amount - show save amount
    * @param {string} product_save_type - dollar or percent
    * @param {boolean} superscript_decimals - whether to superscript decimals
    * @param {boolean} set_image_breathing_room - whether to set image breathing room
  */
{% endcomment %}

{%- liquid
  unless limit
    assign limit = main_menu.links.size
  endunless
  unless offset
    assign offset = 0
  endunless

  assign text_direction = text_direction | default: settings.text_direction
  if text_direction == 'rtl'
    assign chevron_icon = 'chevron-left'
  else
    assign chevron_icon = 'chevron-right'
  endif
-%}

<ul class="site-nav site-navigation site-navigation--{{ nav_position }} small--hide">
  {%- for link in main_menu.links limit: limit offset: offset -%}
    {%- liquid
      assign link_index = forloop.index

      assign has_dropdown = false
      assign is_megamenu = false
      if link.levels > 0
        assign has_dropdown = true
        if link.levels > 1
          assign is_megamenu = true
        endif
      endif

      assign isCollection = false
      if show_mega_products
        if is_megamenu and link.url contains routes.collections_url
          assign collection_handle = link.url | remove: routes.collections_url | remove: '/'
          assign collection_drop = collections[collection_handle]
          assign isCollection = true
        endif
      endif

      comment
        Match this nav link to a mega menu block by its "Menu Item" text.
      endcomment
      assign link_title_downcase = link.title | strip | downcase
      assign mega_menu_block = nil
      for block in section.blocks
        assign menu_item_downcase = block.settings.menu_item | strip | downcase
        if menu_item_downcase == link_title_downcase
          assign mega_menu_block = block
          break
        endif
      endfor

      assign uses_details = false
      if has_dropdown or mega_menu_block
        assign uses_details = true
      endif
    -%}

    <li class="site-nav__item site-nav__expanded-item{% if has_dropdown %} site-nav--has-dropdown{% endif %}{% if mega_menu_block %} site-nav--is-megamenu{% endif %}">
      {%- if uses_details -%}
        <details
          id="site-nav-item--{{ link_index }}"
          class="site-nav__details"
          data-hover="{{ hover_menu }}"
        >
          <summary
            data-link="{{ link.url }}"
            aria-expanded="false"
            aria-controls="site-nav-item--{{ link_index }}"
            class="site-nav__link site-nav__link--underline{% if has_dropdown %} site-nav__link--has-dropdown{% endif %}"
          >
            {{ link.title }}
            {% render 'icon', name: 'chevron-down' %}
          </summary>
      {%- else -%}
        <a
          href="{{ link.url }}"
          class="site-nav__link site-nav__link--underline"
        >
          {{ link.title }}
        </a>
      {%- endif -%}

      {%- if is_megamenu or mega_menu_block -%}
        <div class="site-nav__dropdown megamenu text-left">
          <div class="page-width">
            <div class="site-nav__dropdown-animate megamenu__wrapper">

              {%- if mega_menu_block.type == 'megamenulink' -%}
                {%- liquid
                  assign mega_links = mega_menu_block.settings.megamenu_main_menu_link_list.links

                  assign categories_label = mega_menu_block.settings.categories_label
                  assign badge_text = mega_menu_block.settings.badge_text
                  assign button_label = mega_menu_block.settings.button_label | default: 'Shop All Best Sellers'
                  assign shop_all_label = mega_menu_block.settings.shop_all_label | default: 'Shop All'

                  comment
                    Pre-select the category for the current page, otherwise the first one.
                  endcomment
                  assign active_index = 1
                  for childlink in mega_links
                    if childlink.active or childlink.child_active
                      assign active_index = forloop.index
                      break
                    endif
                  endfor

                  comment
                    Default promo, used until a category with its own image is active.
                  endcomment
                  if mega_menu_block.settings.default_image
                    assign default_promo_src = mega_menu_block.settings.default_image | image_url: width: 600
                  else
                    assign default_promo_src = 'https://cdn.shopify.com/s/files/1/0673/0045/8748/files/Best_Sellers.jpg?v=1723790108'
                  endif
                  assign default_promo_href = mega_menu_block.settings.default_button_url | default: '#'

                  assign promo_src = default_promo_src
                  assign promo_href = default_promo_href
                -%}

                <div class="megamenu__cols megamenu__cols--rail" data-megamenu>
                  <div class="megamenu__rail">
                    {%- if categories_label != blank -%}
                      <p class="megamenu__rail-label">{{ categories_label | escape }}</p>
                    {%- endif -%}

                    {%- for childlink in mega_links -%}
                      {%- liquid
                        assign image_key = 'image_' | append: forloop.index
                        assign url_key = 'button_url_' | append: forloop.index
                        assign cat_image = mega_menu_block.settings[image_key]
                        assign cat_button = mega_menu_block.settings[url_key]

                        assign cat_image_src = ''
                        if cat_image
                          assign cat_image_src = cat_image | image_url: width: 600
                        endif

                        if forloop.index == active_index
                          if cat_image_src != blank
                            assign promo_src = cat_image_src
                          endif
                          if cat_button != blank
                            assign promo_href = cat_button
                          endif
                        endif
                      -%}

                      <div class="megamenu__col-title{% if forloop.index == active_index %} is-active{% endif %}">
                        <a
                          href="{{ childlink.url }}"
                          class="site-nav__dropdown-link site-nav__dropdown-link--top-level megamenu__rail-link"
                          data-image-url="{{ cat_image_src }}"
                          data-button-url="{{ cat_button }}"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {% render 'icon', name: chevron_icon %}
                        </a>

                        <div class="megamenu__panel">
                          <div class="megamenu__panel-header">
                            <h3 class="megamenu__panel-title">{{ childlink.title | escape }}</h3>
                            {%- if childlink.type == 'collection_link' -%}
                              <a href="{{ childlink.url }}" class="megamenu__panel-all">{{ shop_all_label | escape }}</a>
                            {%- endif -%}
                          </div>

                          {%- if childlink.links.size > 0 -%}
                            <ul class="megamenu__panel-list">
                              {%- for grandchildlink in childlink.links -%}
                                <li>
                                  <a href="{{ grandchildlink.url }}" class="megamenu__panel-link">
                                    {{- grandchildlink.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>

                  <div class="megamenu__promo">
                    <img
                      src="{{ promo_src }}"
                      alt=""
                      class="megamenu__promo-image js-megamenu-image"
                      data-default-src="{{ default_promo_src }}"
                      loading="lazy"
                    >
                    {%- if badge_text != blank -%}
                      <span class="megamenu__badge">{{ badge_text | escape }}</span>
                    {%- endif -%}
                    <a
                      href="{{ promo_href }}"
                      class="megamenu__button js-megamenu-button"
                      data-default-href="{{ default_promo_href }}"
                    >
                      {{- button_label | escape -}}
                    </a>
                  </div>
                </div>

              {%- elsif mega_menu_block.type == 'megamenulink2' -%}
                <div class="megamenu__cols">
                  <div class="megamenu__col megamenu__col--grid">
                    <div class="megamenu__grid-items">
                      {%- for i in (1..8) -%}
                        {%- liquid
                          assign url_key = 'button_url_' | append: i
                          assign image_key = 'image_' | append: i
                          assign title_key = 'title_' | append: i
                          assign tile_image = mega_menu_block.settings[image_key]
                          assign tile_title = mega_menu_block.settings[title_key]
                        -%}
                        {%- if tile_image or tile_title != blank -%}
                          <div class="megamenu__grid-item">
                            <a href="{{ mega_menu_block.settings[url_key] }}">
                              {%- if tile_image -%}
                                <img
                                  src="{{ tile_image | image_url: width: 600 }}"
                                  alt="{{ tile_title | escape }}"
                                  loading="lazy"
                                >
                              {%- endif -%}
                              <h2>{{ tile_title | escape }}</h2>
                            </a>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if isCollection -%}
                <div class="megamenu__featured">
                  <div class="product-grid">
                    {%- liquid
                      assign mega_product = collection_drop.products.first

                      render 'product-grid-item', product: mega_product, sizeVariable: '19vw', collection: collection, quick_add_enable: quick_add_enable, quick_shop_enable: quick_shop_enable, product_grid_image_size: product_grid_image_size, product_grid_image_fill: product_grid_image_fill, product_hover_image: product_hover_image, enable_swatches: enable_swatches, vendor_enable: vendor_enable, product_save_amount: product_save_amount, product_save_type: product_save_type, superscript_decimals: superscript_decimals, set_image_breathing_room: set_image_breathing_room, enable_product_tags: enable_product_tags, product_grid_style: product_grid_style
                    -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

      {%- elsif has_dropdown -%}
        <div class="site-nav__dropdown">
          <ul class="site-nav__dropdown-animate site-nav__dropdown-list text-left">
            {%- for childlink in link.links -%}
              {%- liquid
                assign has_sub_dropdown = false
                if childlink.levels > 0
                  assign has_sub_dropdown = true
                endif
              -%}

              <li class="{% if has_sub_dropdown %} site-nav__deep-dropdown-trigger{% endif %}">
                <a
                  href="{{ childlink.url }}"
                  class="site-nav__dropdown-link site-nav__dropdown-link--second-level{% if has_sub_dropdown %} site-nav__dropdown-link--has-children{% endif %}"
                >
                  {{ childlink.title | escape }}
                  {%- if has_sub_dropdown -%}
                    {% render 'icon', name: 'chevron-down' %}
                  {%- endif -%}
                </a>
                {%- if has_sub_dropdown -%}
                  <ul class="site-nav__deep-dropdown">
                    {%- for grandchildlink in childlink.links -%}
                      <li>
                        <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">
                          {{- grandchildlink.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if uses_details -%}
        </details>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
