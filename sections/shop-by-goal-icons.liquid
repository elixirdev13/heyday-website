<style>
  .shop-by-goal {
    background: var(--sbg-bg, #EAF0E6);
    padding: 64px 0;
  }

  .shop-by-goal__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .shop-by-goal__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 40px;
  }

  .shop-by-goal__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sbg-heading-color, #1F3D2B);
    opacity: 0.7;
  }

  .shop-by-goal__heading {
    margin: 0 0 12px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--sbg-heading-color, #1F3D2B);
  }

  .shop-by-goal__subheading {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--sbg-text-color, #1F3D2B);
    opacity: 0.85;
  }

  .shop-by-goal__subheading p {
    margin: 0;
  }

  .shop-by-goal__grid {
    display: grid;
    grid-template-columns: repeat(var(--sbg-columns, 4), 1fr);
    gap: 20px;
  }

  .shop-by-goal__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: var(--sbg-card-bg, #FFFFFF);
    border-radius: 16px;
    padding: 40px 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  a.shop-by-goal__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .shop-by-goal__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--sbg-icon-bg, #EFEFEF);
    color: var(--sbg-heading-color, #1F3D2B);
  }

  .shop-by-goal__icon img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .shop-by-goal__card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--sbg-text-color, #1F3D2B);
    text-align: center;
  }

  .shop-by-goal__placeholder {
    text-align: center;
    padding: 40px;
    border: 1px dashed rgba(0, 0, 0, 0.15);
    border-radius: 12px;
  }

  @media screen and (max-width: 989px) {
    .shop-by-goal__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .shop-by-goal {
      padding: 40px 0;
    }

    .shop-by-goal__heading {
      font-size: 26px;
    }

    .shop-by-goal__card {
      padding: 28px 16px;
    }
  }
</style>

<section
  class="shop-by-goal"
  style="
    --sbg-bg: {{ section.settings.background_color }};
    --sbg-card-bg: {{ section.settings.card_background_color }};
    --sbg-icon-bg: {{ section.settings.icon_background_color }};
    --sbg-heading-color: {{ section.settings.heading_color }};
    --sbg-text-color: {{ section.settings.text_color }};
    --sbg-columns: {{ section.settings.columns_desktop }};
  "
>
  <div class="shop-by-goal__inner page-width">

    {%- if section.settings.eyebrow != blank
       or section.settings.heading != blank
       or section.settings.subheading != blank -%}
      <div class="shop-by-goal__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="shop-by-goal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="shop-by-goal__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="shop-by-goal__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="shop-by-goal__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_tag = 'div'
            if block.settings.link != blank
              assign card_tag = 'a'
            endif
          -%}
          <{{ card_tag }}
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            class="shop-by-goal__card"
            {{ block.shopify_attributes }}
          >
            <span class="shop-by-goal__icon">
              {%- if block.settings.icon -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt=""
                  loading="lazy"
                  width="40"
                  height="40"
                >
              {%- else -%}
                {%- case block.settings.icon_fallback -%}
                  {%- when 'scale' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v18M6 7h12M4 7l2.5 6a2.5 2.5 0 0 0 5 0L9 7M14.5 7 17 13a2.5 2.5 0 0 0 5 0L19.5 7M8 21h8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'bolt' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 4C10 4 4 10 4 18c8 0 14-6 14-14ZM4 20 12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 4 6v6c0 5 3.5 7.7 8 9 4.5-1.3 8-4 8-9V6l-8-3Z" stroke-linecap="round" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'moon' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 3v4M16 5h4" stroke-linecap="round"/></svg>
                  {%- when 'muscle' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="2.5"/><circle cx="15" cy="15" r="2.5"/><path d="M11.5 9c2 0 3.5 1.5 3.5 3.5M8 15c0-2 1.5-3.5 3.5-3.5" stroke-linecap="round"/></svg>
                  {%- when 'calm' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6" stroke-linecap="round"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20s-7-4.4-9.5-9C.8 7.5 3 4 6.5 4 9 4 11 6 12 7.5 13 6 15 4 17.5 4 21 4 23.2 7.5 21.5 11c-2.5 4.6-9.5 9-9.5 9Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 11h2l1.5-2 2 4L15 11h2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>

            {%- if block.settings.title != blank -%}
              <span class="shop-by-goal__card-title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </{{ card_tag }}>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-by-goal__placeholder">
        {{ 'onboarding_content.default_collection_title' | t }}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Shop by Goal",
  "tag": "section",
  "class": "section shop-by-goal-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Targeted Wellness"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Goal"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Explore premium remedies crafted carefully by medical herbalists to bring your bodily systems back into perfect, vibrant harmony.</p>"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns (desktop)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#EAF0E6"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon circle background",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F3D2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#1F3D2B"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Goal card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "40x40px recommended. Leave blank to use a fallback icon."
        },
        {
          "type": "select",
          "id": "icon_fallback",
          "label": "Fallback icon",
          "options": [
            { "value": "scale", "label": "Scale (weight)" },
            { "value": "bolt", "label": "Bolt (energy)" },
            { "value": "leaf", "label": "Leaf (gut health)" },
            { "value": "shield", "label": "Shield (immunity)" },
            { "value": "moon", "label": "Moon (sleep)" },
            { "value": "muscle", "label": "Muscle (recovery)" },
            { "value": "calm", "label": "Circle-X (stress)" },
            { "value": "heart", "label": "Heart (heart health)" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Goal name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Usually a collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Goal",
      "blocks": [
        { "type": "card", "settings": { "title": "Weight Management", "icon_fallback": "scale" } },
        { "type": "card", "settings": { "title": "Energy Boost", "icon_fallback": "bolt" } },
        { "type": "card", "settings": { "title": "Gut Health", "icon_fallback": "leaf" } },
        { "type": "card", "settings": { "title": "Immunity Support", "icon_fallback": "shield" } },
        { "type": "card", "settings": { "title": "Better Sleep", "icon_fallback": "moon" } },
        { "type": "card", "settings": { "title": "Muscle Recovery", "icon_fallback": "muscle" } },
        { "type": "card", "settings": { "title": "Stress Relief", "icon_fallback": "calm" } },
        { "type": "card", "settings": { "title": "Heart Health", "icon_fallback": "heart" } }
      ]
    }
  ]
}
{% endschema %}