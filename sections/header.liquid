<style>
  #shopify-section-{{ section.id }} .site-nav__link {
    font-size: 16px;
    letter-spacing: 0em;
    text-transform: none;
    font-weight: 500;
    color: #232323;
  }
  #shopify-section-{{ section.id }} #site-nav-item--5 > .site-nav__link {
    color: #fff;
    padding: 8px 15px;
  }

  /* Generic dropdown links (non-mega dropdowns) */
  #shopify-section-{{ section.id }} .site-nav__dropdown-link {
    display: block;
    padding: 0px 12px;
    color: #333;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .site-nav__dropdown-link:hover {
    background-color: #164734;
    font-weight: 700;
    color: #ffffff;
    border-radius: 12px;
  }

  /* ------------------------------------------------------------------
     Mega menu (megamenulink): rail | flyout panel | promo
     ------------------------------------------------------------------ */
  #shopify-section-{{ section.id }} .megamenu {
    --mm-green: #164734;
    --mm-cream: #FDF7EE;
    --mm-ivory: #FEFEF7;
    --mm-amber: #F5A623;
    --mm-yellow: #F2D96B;
    --mm-rail: 24%;
    --mm-promo: 24%;
    padding-bottom: 0;
  }

  /* Base layout shared by both mega menu types. These reset the theme's
     multi-column rule; the rail variant below overrides display with grid. */
  #shopify-section-{{ section.id }} .megamenu__cols {
    flex: none;
    flex-flow: nowrap;
    columns: 1;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .megamenu__col {
    position: relative;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .megamenu__cols--rail {
    position: relative;
    display: grid;
    grid-template-columns: var(--mm-rail) 1fr var(--mm-promo);
    min-height: 250px;
    max-width: 820px;
    margin: 0 auto;
  }

  /* Left rail */
  #shopify-section-{{ section.id }} .megamenu__rail {
    grid-column: 1;
    background-color: var(--mm-cream);
    padding: 16px 10px 12px 14px;
  }
  #shopify-section-{{ section.id }} .megamenu__rail-label {
    margin: 0 0 8px;
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6b6b;
  }
  #shopify-section-{{ section.id }} .megamenu__col-title {
    margin: 0 0 2px;
  }
  #shopify-section-{{ section.id }} .megamenu__rail-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    color: #232323;
  }
  #shopify-section-{{ section.id }} .megamenu__rail-link svg {
    flex: none;
    width: 10px;
    height: 10px;
  }
  #shopify-section-{{ section.id }} .megamenu__col-title.is-active > .megamenu__rail-link,
  #shopify-section-{{ section.id }} .megamenu__rail-link:hover,
  #shopify-section-{{ section.id }} .megamenu__rail-link:focus-visible {
    background-color: var(--mm-green);
    color: #fff;
    font-weight: 600;
  }

  /* Center flyout panel */
  #shopify-section-{{ section.id }} .megamenu__panel {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--mm-rail);
    right: var(--mm-promo);
    padding: 16px 22px;
    background-color: var(--mm-ivory);
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .megamenu__col-title.is-active > .megamenu__panel {
    display: block;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--mm-green);
  }
  #shopify-section-{{ section.id }} .megamenu__panel-all {
    font-size: 10px;
    font-weight: 500;
    color: var(--mm-green);
    text-decoration: underline;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-list li {
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-link {
    position: relative;
    display: inline-block;
    padding-left: 12px;
    font-size: 12px;
    line-height: 1.4;
    color: #232323;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .megamenu__panel-link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background-color: var(--mm-amber);
  }
  #shopify-section-{{ section.id }} .megamenu__panel-link:hover,
  #shopify-section-{{ section.id }} .megamenu__panel-link:focus-visible {
    color: var(--mm-green);
    text-decoration: underline;
  }

  /* Right promo column */
  #shopify-section-{{ section.id }} .megamenu__promo {
    grid-column: 3;
    position: relative;
    overflow: hidden;
    min-height: 250px;
    background-color: var(--mm-green);
  }
  #shopify-section-{{ section.id }} .megamenu__promo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .megamenu__promo::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(22, 71, 52, 0.55);
    z-index: 1;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .megamenu__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 4px 10px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .megamenu__button {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 14px;
    z-index: 2;
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    background-color: var(--mm-yellow);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    color: var(--mm-green);
  }
  #shopify-section-{{ section.id }} .megamenu__button:hover {
    filter: brightness(0.96);
  }

  /* ------------------------------------------------------------------
     Mega menu 2 (megamenulink2): image grid
     ------------------------------------------------------------------ */
  #shopify-section-{{ section.id }} .megamenu__col--grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 12px 6px;
  }
  #shopify-section-{{ section.id }} .megamenu__grid-items {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .megamenu__grid-item {
    background-color: #fff;
    padding: 0;
    flex: 0 0 130px;
    width: 130px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .megamenu__grid-item > a {
    position: relative;
  }
  #shopify-section-{{ section.id }} .megamenu__grid-item:hover {
    transform: translateY(-5px);
  }
  #shopify-section-{{ section.id }} .megamenu__grid-item img {
    display: block;
    width: 130px;
    max-width: 100%;
    height: 130px;
    object-fit: cover;
    margin-bottom: 6px;
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} .megamenu__grid-item h2 {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    transition: color 0.3s ease;
    font-family: "MajesticKingdome";
    text-align: center;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .megamenu__grid-item {
      flex: 0 0 calc(50% - 8px);
      width: calc(50% - 8px);
    }
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .megamenu__grid-item {
      flex: 0 0 100%;
      width: 100%;
    }
  }

  /* ------------------------------------------------------------------
     Mobile drawer (header-mobile-nav): same tokens as desktop
     ------------------------------------------------------------------ */
  #shopify-section-{{ section.id }} .slide-nav__wrapper {
    --mm-green: #164734;
    --mm-amber: #F5A623;
    --mm-yellow: #F2D96B;
  }

  #shopify-section-{{ section.id }} .slide-nav__label {
    padding: 16px 20px 6px;
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  #shopify-section-{{ section.id }} .slide-nav__link--dot > span::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 12px;
    border-radius: 50%;
    vertical-align: middle;
    background-color: var(--mm-amber);
  }

  #shopify-section-{{ section.id }} .slide-nav__promo {
    position: relative;
    overflow: hidden;
    min-height: 220px;
    margin: 16px 20px 24px;
    border-radius: 16px;
    background-color: var(--mm-green);
  }
  #shopify-section-{{ section.id }} .slide-nav__promo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .slide-nav__promo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(22, 71, 52, 0.55);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .slide-nav__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    padding: 5px 12px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .slide-nav__promo-button {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    z-index: 2;
    display: block;
    padding: 12px 20px;
    border-radius: 999px;
    background-color: var(--mm-yellow);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    color: var(--mm-green);
  }

  #shopify-section-{{ section.id }} .slide-nav__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 12px;
    padding: 16px 20px 24px;
  }
  #shopify-section-{{ section.id }} .slide-nav__grid-item {
    display: block;
    text-align: center;
    text-decoration: none;
    color: var(--mm-green);
  }
  #shopify-section-{{ section.id }} .slide-nav__grid-item img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 8px;
    border-radius: 8px;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .slide-nav__grid-title {
    font-family: "MajesticKingdome";
    font-size: 14px;
    font-weight: 600;
  }
</style>

{%- render 'section-header',
  section: section,
  main_menu_link_list: section.settings.main_menu_link_list,
  logo_alignment: 'left',
  nav_position: 'below',
  main_menu_alignment: section.settings.main_menu_alignment,
  overlay_header: false,
  collection: collection,
  sticky_index: section.settings.sticky_index,
  sticky_collection: section.settings.sticky_collection,
  type_navigation_size: settings.type_navigation_size,
  type_navigation_capitalize: settings.type_navigation_capitalize,
  color_header: settings.color_header,
  color_header_search: settings.color_header_search,
  color_body_bg: settings.color_body_bg,
  type_navigation_style: settings.type_navigation_style,
  header_sticky: section.settings.header_sticky,
  context: 'header',
  disable_aria: false,
  mega_products: section.settings.mega_products,
  hover_menu: section.settings.hover_menu,
  header_footer_menu: section.settings.header_footer_menu,
  cart_notes_enable: settings.cart_notes_enable,
  cart_terms_conditions_enable: settings.cart_terms_conditions_enable,
  cart_terms_conditions_page: settings.cart_terms_conditions_page,
  cart_type: settings.cart_type,
  cart_additional_buttons: settings.cart_additional_buttons,
  quick_add_enable: settings.quick_add_enable,
  quick_shop_enable: settings.quick_shop_enable,
  product_grid_image_size: settings.product_grid_image_size,
  product_grid_image_fill: settings.product_grid_image_fill,
  product_hover_image: settings.product_hover_image,
  enable_swatches: settings.enable_swatches,
  vendor_enable: settings.vendor_enable,
  product_save_amount: settings.product_save_amount,
  product_save_type: settings.product_save_type,
  superscript_decimals: settings.superscript_decimals,
  predictive_search_enabled: settings.predictive_search_enabled,
  cart_icon: settings.cart_icon,
  text_direction: settings.text_direction,
  cart_collection_handle: settings.cart_collection,
  hydration: 'on:idle',
  set_image_breathing_room: true,
  product_grid_style: settings.product_grid_style
-%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-megamenu]').forEach(function (menu) {
      var rows = menu.querySelectorAll('.megamenu__col-title');
      var image = menu.querySelector('.js-megamenu-image');
      var button = menu.querySelector('.js-megamenu-button');
      if (!rows.length) return;

      function activate(row) {
        var link = row.querySelector('.megamenu__rail-link');
        if (!link) return;

        rows.forEach(function (item) {
          item.classList.toggle('is-active', item === row);
        });

        if (image) {
          image.src = link.dataset.imageUrl || image.dataset.defaultSrc;
        }
        if (button) {
          button.href = link.dataset.buttonUrl || button.dataset.defaultHref;
        }
      }

      rows.forEach(function (row) {
        row.addEventListener('mouseenter', function () { activate(row); });
        row.addEventListener('focusin', function () { activate(row); });
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const fifthNavItem = document.querySelector('.site-nav__item:nth-of-type(5) > a');
    if (fifthNavItem) {
      fifthNavItem.setAttribute('target', '_blank');
    }
  });
</script>

